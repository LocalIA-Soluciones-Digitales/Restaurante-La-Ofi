# =============================================================================
# Restaurante La Ofi — variables de entorno
# Copia este archivo a .env.local para desarrollo. En Vercel: Project Settings →
# Environment Variables (Production y Preview). Nunca commitees valores reales.
# Las variables NEXT_PUBLIC_* acaban en el navegador: solo valores públicos.
# =============================================================================

# --- Sitio -------------------------------------------------------------------
# URL pública sin barra final. Se usa para canonical, sitemap, Open Graph y
# hreflang. Dominio pendiente: mientras tanto, la URL de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demo. "true" (o vacío) = noindex/nofollow en todas las páginas, robots.txt
# que bloquea todo y sitemap vacío. Poner "false" SOLO al pasar a producción
# (ver README → "De demo a producción").
NEXT_PUBLIC_IS_DEMO=true

# Contenido de ejemplo cuando Supabase no devuelve datos (carta, menú del día,
# eventos). Todo lo de ejemplo se marca visualmente como "Ejemplo".
# "false" = sin datos se muestran estados vacíos ("Próximamente", etc.).
NEXT_PUBLIC_SHOW_DEMO_CONTENT=true

# Fotos de plantilla (stock de Unsplash, «Imagen ilustrativa») mientras no haya fotos
# profesionales del local. Solo "false" las apaga y vuelve a las fotos reales.
NEXT_PUBLIC_FOTOS_PLANTILLA=true

# Teléfono de contacto (solo dígitos o con espacios). Se usa en "Reservar"
# (tel:), cabecera, pie y JSON-LD.
# TEMPORAL: 628409781 es un número DE PRUEBAS. El teléfono real verificado en
# Google Business es 946366479: cámbialo antes de producción.
NEXT_PUBLIC_CONTACT_PHONE=628409781

# WhatsApp (solo dígitos, con prefijo de país, p. ej. 34600000000). Vacío = no se
# muestra ningún botón de WhatsApp. Pendiente de confirmar con el propietario.
NEXT_PUBLIC_WHATSAPP=

# --- Supabase (proyecto compartido de LocalIA) --------------------------------
# Clave anon/publishable: pública por diseño, todo acceso pasa por RPC que
# resuelven el tenant desde la site_key. NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# site_key (uuid) de La Ofi en public.clientes (supabase/seed/la_ofi_tenant.sql).
# Solo se usa en el servidor: sin prefijo NEXT_PUBLIC_ para que no llegue al
# navegador. En Vercel, tipo "secret".
LAOFI_SITE_KEY=

# --- Pagos online (Stripe) — SOLO servidor, nunca NEXT_PUBLIC_* ------------------
# Sin estas variables el pago online queda desactivado y se puede pagar en el
# local. Además hay que activar "online" en /admin/configuracion (ajuste pagos).
# Webhook: https://<dominio>/api/stripe/webhook, eventos checkout.session.completed
# y checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# service_role: SOLO la usan las rutas de Stripe (crear el checkout con el importe
# real y marcar pagos desde el webhook). Secreta en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- TicketBAI (Bizkaia) — APAGADO. Ver src/lib/ticketbai/README.md -------------
# No activar hasta tener certificado, firma probada y envío a Batuz completado.
# TICKETBAI_ENABLED=false
# TICKETBAI_NIF=
# TICKETBAI_RAZON_SOCIAL=
# TICKETBAI_SERIE=WEB
# TICKETBAI_LICENCIA=
# TICKETBAI_ENTIDAD_DESARROLLADORA_NIF=
# TICKETBAI_SOFTWARE_NOMBRE=La Ofi TPV
# TICKETBAI_SOFTWARE_VERSION=1.0

# --- Equipo (/admin/staff) ---------------------------------------------------
# Crear cuentas de staff desde el panel usa la API de administración de Supabase
# Auth con SUPABASE_SERVICE_ROLE_KEY (arriba). Sin ella, el panel explica cómo
# crearlas desde el dashboard de Supabase.

# --- Desarrollo ---------------------------------------------------------------
# "1" = backend LOCAL en memoria (PGlite + migraciones + datos de prueba) en vez de
# Supabase. Solo para desarrollo (npm run dev:local). NUNCA en Vercel.
# LAOFI_PGLITE=
