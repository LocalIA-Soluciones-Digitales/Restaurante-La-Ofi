# Copia este archivo a ".env" y rellena los valores. NUNCA subas el ".env" a git.

# Mismos valores que la web (Vercel → NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY):
SUPABASE_URL=https://ukhfaphloxlszomccgde.supabase.co
SUPABASE_ANON_KEY=

# Cuenta de /admin dedicada a este servicio (rol "cocina" en /admin/staff basta).
BRIDGE_EMAIL=
BRIDGE_PASSWORD=

# Impresora de COCINA en red (IP fija, puerto crudo 9100). Vacío = no imprime cocina.
PRINTER_COCINA_INTERFACE=tcp://192.168.1.50:9100

# Impresora de BARRA: en red (tcp://IP:9100) o por USB en Windows (nombre del
# PUERTO, p. ej. USB001, en Propiedades de la impresora → Puertos).
PRINTER_BARRA_INTERFACE=
PRINTER_BARRA_PUERTO_WINDOWS=

# EPSON (por defecto) o STAR, según el juego de comandos de la impresora.
PRINTER_TIPO=EPSON
